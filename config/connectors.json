          "method": "json_path",
          "expression": "$.uplink_mode",
          "transforms": [
            "strip"
          ],
          "value_type": "string",
          "availability_on_missing": "unsupported"
        },
        {
          "id": "system-compile-time",
          "metric": "system.compile_time",
          "endpoint": "base_info",
          "method": "json_path",
          "expression": "$.compile_time",
          "transforms": [
            "strip"
          ],
          "value_type": "string",
          "availability_on_missing": "unsupported"
        },
        {
          "id": "identity-gpon-sn",
          "metric": "device.gpon_sn",
          "endpoint": "base_info",
          "method": "json_path",
          "expression": "$.gponsn",
          "transforms": [
            "strip"
          ],
          "value_type": "string",
          "availability_on_missing": "unsupported"
        },
        {
          "id": "system-kernel",
          "metric": "system.kernel",
          "endpoint": "base_info",
          "method": "json_path",
          "expression": "$.os_version",
          "transforms": [
            "strip"
          ],
          "value_type": "string",
          "availability_on_missing": "unsupported"
        },
        {
          "id": "system-memory",
          "metric": "system.memory_percent",
          "endpoint": "base_info",
          "method": "json_path_multi",
          "expression": "$.mem_total,$.mem_free",
          "transforms": [
            "used_percent"
          ],
          "value_type": "percent",
          "availability_on_missing": "unsupported"
        },
        {
          "id": "lan-ports",
          "collection": "lan_ports",
          "endpoint": "base_info",
          "method": "keyed_objects",
          "expression": "$",
          "range": {
            "start": 1,
            "count_field": "lan_port_num",
            "max": 16
          },
          "item_fields": {
            "name": {
              "literal": "LAN{n}",
              "target": "name"
            },
            "status": {
              "field": "lan_status_{n}",
              "target": "status",
              "transforms": [
                "strip"
              ]
            }
          },
          "availability_on_missing": "unsupported"
        },
        {
          "id": "ssids",
          "collection": "ssids",
          "endpoint": "wan_info",
          "method": "keyed_objects",
          "expression": "$.wifi_obj_enable",
          "range": {
            "start": 1,
            "end": 16
          },
          "item_fields": {
            "name": {
              "field": "ssid{n}",
              "target": "name",
              "transforms": [
                "strip"
              ]
            },
            "active": {
              "field": "ConfigActive{n}",
              "target": "active",
              "transforms": [
                "strip"
              ]
            }
          },
          "filter": {
            "field": "active",
            "operator": "equals",
            "value": "1"
          },
          "availability_on_missing": "unsupported"
        },
        {
          "id": "devices-list",
          "collection": "devices",
          "endpoint": "lan_status",
          "method": "list_objects",
          "expression": "$.lan_status.data",
          "item_fields": {
            "id": {
              "field": "MACAddress",
              "target": "id",
              "transforms": [
                "strip"
              ]
            },
            "hostname": {
              "field": "HostName",
              "fallback_field": "IPAddress",
              "target": "hostname",
              "default": "unknown",
              "transforms": [
                "strip"
              ]
            },
            "ip_address": {
              "field": "IPAddress",
              "target": "ip_address",
              "transforms": [
                "decode_point_encoded_ip"
              ]
            },
            "mac_address": {
              "field": "MACAddress",
              "target": "mac_address",
              "transforms": [
                "strip"
              ]
            },
            "link_type": {
              "field": "AccessType",
              "fallback_field": "InterfaceType",
              "target": "link_type",
              "default": "-",
              "transforms": [
                "strip"
              ]
            },
            "address_source": {
              "field": "AddressSource",
              "target": "address_source",
              "transforms": [
                "strip"
              ]
            },
            "uptime_s": {
              "field": "ClientUpTime",
              "target": "uptime_s",
              "transforms": [
                "integer"
              ]
            },
            "raw": {
              "target": "raw"
            }
          },
          "value_type": "integer",
          "availability_on_missing": "unavailable"
        }
      ],
      "validation": [
        {
          "metric": "device.manufacturer",
          "rule": "non_empty",
          "on_failure": "invalid"
        },
        {
          "metric": "device.model",
          "rule": "non_empty",
          "on_failure": "invalid"
        },
        {
          "metric": "device.mac_base",
          "rule": "mac",
          "on_failure": "invalid"
        },
        {
          "metric": "device.mac_wan",
          "rule": "mac",
          "on_failure": "invalid"
        },
        {
          "metric": "wan.public_ip",
          "rule": "ipv4",
          "on_failure": "invalid"
        },
        {
          "metric": "wan.gateway_ip",
          "rule": "ipv4",
          "on_failure": "invalid"
        },
        {
          "metric": "wan.mac",
          "rule": "mac",
          "on_failure": "invalid"
        },
        {
          "metric": "wan.mtu",
          "rule": "number",
          "on_failure": "invalid"
        },
        {
          "metric": "wan.uptime_s",
          "rule": "duration_seconds",
          "on_failure": "invalid"
        },
        {
          "metric": "wan.nat",
          "rule": "one_of",
          "options": {
            "values": [
              "Enabled",
              "Disabled"
            ]
          },
          "on_failure": "invalid"
        },
        {
          "metric": "optical.tx_power_dbm",
          "rule": "dbm_range",
          "options": {
            "min": -40,
            "max": 10
          },
          "on_failure": "invalid"
        },
        {
          "metric": "optical.rx_power_dbm",
          "rule": "dbm_range",
          "options": {
            "min": -40,
            "max": 10
          },
          "on_failure": "invalid"
        },
        {
          "metric": "voip.phone_number",
          "rule": "phone_e164",
          "on_failure": "invalid"
        },
        {
          "metric": "voip.registration_state",
          "rule": "non_empty",
          "on_failure": "unavailable"
        },
        {
          "metric": "system.uptime_s",
          "rule": "duration_seconds",
          "on_failure": "invalid"
        },
        {
          "metric": "devices.count",
          "rule": "number",
          "on_failure": "invalid"
        },
        {
          "metric": "device.gpon_sn",
          "rule": "non_empty",
          "on_failure": "invalid"
        },
        {
          "metric": "system.kernel",
          "rule": "non_empty",
          "on_failure": "invalid"
        },
        {
          "metric": "system.memory_percent",
          "rule": "number",
          "on_failure": "invalid"
        }
      ],
      "dependencies": {
        "login": [
          "seed"
        ],
        "logout": [
          "login",
          "login_user"
        ],
        "base_info": [
          "login"
        ],
        "wan_info": [
          "login"
        ],
        "lan_status": [
          "login"
        ],
        "operator": [
          "login"
        ],
        "dongle_info": [
          "login"
        ],
        "ipv6_lan": [
          "login"
        ],
        "login_user": [
          "login"
        ],
        "voice_status": [
          "login"
        ]
      },
      "capabilities": [
        "device_identity",
        "wan",
        "optical",
        "voip",
        "system",
        "connected_devices"
      ],
      "limitations": [
        "Only fields observed on one HG6145F1 are described here.",
        "Speed testing is local to the host and is not provided by this connector.",
        "IPv6 and USB dongle payloads are collected by the legacy path but not yet mapped to universal metrics or collections.",
