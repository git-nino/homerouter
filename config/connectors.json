{
  "schema_version": 1,
  "connectors": [
    {
      "id": "fiberhome.hg6145f1",
      "display_name": "FiberHome HG6145F1 (observed)",
      "status": "observed",
      "enabled": true,
      "manufacturer_id": "fiberhome",
      "model": "HG6145F1",
      "evidence": {
        "source": "Phase 1 audit of real HTTP responses from one HG6145F1 gateway; sensitive values redacted.",
        "verified": true,
        "notes": [
          "Endpoint and field names were observed on the physical device.",
          "Status remains 'observed', not 'verified', because full profile compatibility still requires normalized-output comparison on that device.",
          "No credential values, phone numbers, public IPs, or serial numbers are stored here."
        ]
      },
      "identification": {
        "confidence": "partial",
        "rules": [
          {
            "id": "preauth-model-name",
            "phase": "pre_auth",
            "source": "device_name",
            "field": "ModelName",
            "operator": "equals",
            "value": "HG6145F1",
            "confidence": "partial",
            "weight": 60,
            "evidence": "get_device_name returned this ModelName on the observed gateway; a model string alone is not firmware-unique."
          },
          {
            "id": "postauth-manufacturer",
            "phase": "post_auth",
            "source": "base_info",
            "field": "Manufacturer",
            "operator": "equals",
            "value": "FiberHome",
            "confidence": "partial",
            "weight": 20,
            "evidence": "Observed in get_base_info."
          },
          {
            "id": "postauth-model-name",
            "phase": "post_auth",
            "source": "base_info",
            "field": "ModelName",
            "operator": "equals",
            "value": "HG6145F1",
            "confidence": "partial",
            "weight": 60,
            "evidence": "Observed in get_base_info."
          }
        ]
      },
      "auth": {
        "credential_suggestion_key": "fiberhome_observed_defaults",
        "flows": [
          {
            "id": "fiberhome-aes-login",
            "type": "fiberhome_aes",
            "order": 1,
            "endpoints": {
              "seed": "seed",
              "login": "login"
            },
            "fields": {
              "username": {
                "source": "user_input"
              },
              "password": {
                "source": "user_input",
                "transform": "fiberhome_aes_challenge"
              },
              "port": {
                "source": "literal",
                "value": 0
              },
              "sessionid": {
                "source": "seed.sessionid"
              }
            },
            "success": {
              "field": "login_result",
              "allowed": [
                0,
                1
              ]
            },
            "session": {
              "id_field": "sessionid",
              "store": true,
              "cookie": false,
              "validity_field": "session_valid",
              "invalid_values": [
                0
              ]
            }
          }
        ],
        "logout_endpoint": "logout"
      },
      "endpoints": [
        {
          "id": "seed",
          "method": "GET",
          "path": "/cgi-bin/ajax",
          "query": {
            "ajaxmethod": "get_acs_random"
          },
          "format": "json",
          "timeout_seconds": 6,
          "auth": false,
          "description": "Returns acsRandom and sessionid used by the FiberHome AES challenge."
        },
        {
          "id": "login",
          "method": "POST",
          "path": "/cgi-bin/ajax",
          "body": {
            "ajaxmethod": "do_login",
            "username": {
              "source": "user_input"
            },
            "loginpd": {
              "source": "derived",
              "field": "encrypted_password"
            },
            "port": {
              "source": "literal",
              "value": 0
            },
            "sessionid": {
              "source": "state.sessionid"
            }
          },
          "format": "json",
          "timeout_seconds": 8,
          "auth": false,
          "description": "Submits the encrypted password and returns login_result."
        },
        {
          "id": "logout",
          "method": "POST",
          "path": "/cgi-bin/ajax",
          "body": {
            "ajaxmethod": "do_logout",
            "sessionid": {
              "source": "state.sessionid"
            },
            "username": {
              "source": "endpoint_field",
              "endpoint": "login_user",
              "field": "login_user",
              "mapping": {
                "4": "superadmin",
                "2": "admin",
                "default": "common"
              }
            }
          },
          "format": "json",
          "timeout_seconds": 8,
          "auth": true,
          "description": "Explicit logout; role is derived from get_login_user."
        },
        {
          "id": "base_info",
          "method": "GET",
          "path": "/cgi-bin/ajax",
          "query": {
            "ajaxmethod": "get_base_info"
          },
          "format": "json",
          "timeout_seconds": 6,
          "auth": true,
          "description": "Device identity, system, and optical fields."
        },
        {
          "id": "wan_info",
          "method": "GET",
          "path": "/cgi-bin/ajax",
          "query": {
            "ajaxmethod": "get_allwan_info"
          },
          "format": "json",
          "timeout_seconds": 6,
          "auth": true,
          "description": "WAN list and WiFi objects."
        },
        {
